# Chave pública do Maps JavaScript API. Restrinja por domínio/referrer e somente a essa API.
GOOGLE_MAPS_BROWSER_KEY=

# Provedor preferencial após IBGE/CNEFE. Quando configurado, não chama Google.
GEOAPIFY_API_KEY=

# Chave secreta do Geocoding API. Restrinja somente a essa API e nunca envie ao navegador.
GOOGLE_MAPS_GEOCODING_KEY=

# Chave secreta da Address Validation API. Pode ser a mesma chave de servidor se ela tiver as duas APIs habilitadas.
GOOGLE_MAPS_ADDRESS_VALIDATION_KEY=

# Chave secreta do Gemini. Usada somente nas rotas do servidor para o Aster IA e revisão ortográfica.
GEMINI_API_KEY=

# IA preferencial quando configurada, sem fallback para Gemini.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Modelo preferencial do Gemini. Em indisponibilidade, o servidor usa modelos Flash de contingência.
GEMINI_MODEL=gemini-3.1-flash-lite

# Supabase Transaction pooler, porta 6543. Codifique caracteres especiais da senha.
DATABASE_URL=

# Código de uso único para criar o primeiro administrador pela tela de acesso.
ASTER_BOOTSTRAP_TOKEN=

# Chave de servidor restrita à Google Routes API. Se ausente, o Aster usa a chave do Geocoding como contingência.
GOOGLE_MAPS_ROUTES_KEY=

# URL pública da aplicação na Vercel.
APP_URL=


